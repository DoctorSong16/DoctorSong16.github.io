---
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import dundu from '../assets/dundu.jpeg';
import dunduPortrait from '../assets/dundu-portrait.jpeg';

// Art direction: stacked layouts show the full landscape photo; side-by-side
// layouts (lg+) show a 3:4 crop so the image is tall enough to sit beside the text.
const sideBySide = '(min-width: 1024px)';

// Rendered widths: the landscape photo fills the column up to max-w-2xl (42rem);
// the portrait crop gets 1/3 of the hero. The hero is capped at max-w-5xl (64rem),
// the same width where it goes side by side, so that column is always ~19rem.
const landscapeSizes = '(min-width: 44rem) 42rem, calc(100vw - 2rem)';
const portraitSizes = '19rem';

const formats = ['avif', 'webp', 'jpeg'] as const;
const sources = await Promise.all(
  formats.map(async (format) => ({
    type: `image/${format}`,
    portrait: await getImage({ src: dunduPortrait, widths: [320, 480, 640], format }),
    landscape: await getImage({ src: dundu, widths: [400, 672, 1000, 1280], format }),
  })),
);
const fallback = sources.at(-1)!.landscape;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
---

<section class="@container mx-auto max-w-5xl px-4 pt-2 pb-12 sm:px-8 lg:py-12">
  <div class="mx-auto grid max-w-2xl gap-8 lg:max-w-none lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-[5cqi]">
    <!--
      Side by side, the photo is at least 3:4 and otherwise stretches to the text's
      height (cropping its sides), so a longer intro never leaves the text overhanging.
    -->
    <picture class="relative block lg:aspect-[3/4] lg:w-full lg:self-stretch">
      {
        sources.map(({ type, portrait }) => (
          <source
            media={sideBySide}
            type={type}
            srcset={portrait.srcSet.attribute}
            sizes={portraitSizes}
            width={dunduPortrait.width}
            height={dunduPortrait.height}
          />
        ))
      }
      {
        sources.map(({ type, landscape }) => (
          <source type={type} srcset={landscape.srcSet.attribute} sizes={landscapeSizes} />
        ))
      }
      <img
        src={fallback.src}
        srcset={fallback.srcSet.attribute}
        sizes={landscapeSizes}
        width={dundu.width}
        height={dundu.height}
        alt="Dundu smiling outdoors in front of a city skyline"
        class="h-auto w-full rounded-[24px] object-cover drop-shadow-2xl lg:absolute lg:inset-0 lg:h-full"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <!--
      Side by side, the font size scales with the hero's width (cqi). It's tuned so
      an intro of about 150 words matches the photo's 3:4 height. Stacked, it uses
      ordinary readable sizes. The text comes from src/content/pages/home.md (Pages CMS).
    -->
    <div class="hero-intro text-lg leading-relaxed sm:text-xl lg:self-center lg:text-[length:2.09cqi]">
      <h1 class="mb-[0.5em] text-4xl leading-tight lg:text-[2.4em]">{home.data.heading}</h1>
      <Content />
    </div>
  </div>
</section>
