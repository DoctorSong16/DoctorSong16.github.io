---
interface Props {
  name: string;
}

// Just the year the site was built: a quieter line than a "2024–2026" range.
const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-5xl px-4 pt-16 pb-8 text-center text-sm text-muted sm:px-8">
  <p>&copy; {year} {name}</p>
</footer>
