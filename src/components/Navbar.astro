---
import { currentUnderline } from '../lib/underline';

const menuItems = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/post' },
  { name: 'Stuff', path: '/stuff' },
  { name: 'Contact', path: '/contact' },
];

// "/post/welcome-post" should mark "Blog" as the current page.
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (path: string) =>
  path === '/' ? pathname === '/' : pathname === path || pathname.startsWith(`${path}/`);

// Shared motion for the mobile menu: a soft ease-out. Opening staggers the links via
// --delay; closing has no delay so everything leaves together. Respects reduced motion.
const motion =
  'duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-open/menu:[transition-delay:var(--delay,0ms)] motion-reduce:transition-none';
const bar = `absolute inset-x-2.5 top-1/2 -mt-px h-0.5 rounded-full bg-current ${motion} transition-[translate,rotate,scale,opacity]`;
---

<nav class="bg-background text-foreground">
  <!-- Same width and side padding as the home hero, so every page sits on one axis. -->
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between px-4 py-5 sm:px-8 sm:py-8">
    <a href="/" class="whitespace-nowrap text-3xl">
      dundu does stuff
    </a>

    <!--
      Button to open the menu on mobile. The three bars morph into an X: the outer
      bars slide to the middle and rotate, the middle one shrinks away.
    -->
    <button
      id="menu-toggle"
      type="button"
      class="group relative inline-flex h-10 w-10 items-center justify-center rounded-lg text-foreground md:hidden"
      aria-controls="navbar-mobile"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span aria-hidden="true" class={`${bar} -translate-y-[7px] group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45`}></span>
      <span aria-hidden="true" class={`${bar} group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0`}></span>
      <span aria-hidden="true" class={`${bar} translate-y-[7px] group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45`}></span>
    </button>

    <!--
      On desktop, a plain row of links. Hover is a slow colour fade; the current page
      is underlined (see src/lib/underline.ts).
    -->
    <div class="hidden md:block">
      <ul class="flex gap-8">
        {
          menuItems.map((item) => (
            <li>
              <a
                href={item.path}
                class={`block py-1 text-[1.375rem] ${currentUnderline}`}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.name.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      On mobile, we use a collapsible menu. It animates its height by transitioning
      grid rows from 0fr to 1fr (works for any content height), and the links fade
      and slide in one after another. It's inert while closed so links can't be tabbed to.
    -->
    <div
      id="navbar-mobile"
      class={`group/menu grid w-full grid-rows-[0fr] opacity-0 data-open:grid-rows-[1fr] data-open:opacity-100 md:hidden ${motion} transition-[grid-template-rows,opacity]`}
      inert
    >
      <ul class="flex min-h-0 flex-col overflow-hidden">
        {
          menuItems.map((item, i) => (
            <li
              class={`-translate-y-2 opacity-0 first:mt-4 last:pb-2 group-data-open/menu:translate-y-0 group-data-open/menu:opacity-100 ${motion} transition-[translate,opacity]`}
              style={`--delay: ${60 + i * 40}ms`}
            >
              <a
                href={item.path}
                class={`my-2 inline-block text-2xl ${currentUnderline}`}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.name.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('navbar-mobile')!;

  const setOpen = (open: boolean) => {
    menu.toggleAttribute('data-open', open);
    menu.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  toggle.addEventListener('click', () => setOpen(!menu.hasAttribute('data-open')));

  // Escape closes the menu and returns focus to the button.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.hasAttribute('data-open')) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
