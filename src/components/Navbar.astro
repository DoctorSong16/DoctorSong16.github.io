---
const menuItems = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/post' },
  { name: 'Stuff', path: '/stuff' },
  { name: 'Contact', path: '/contact' },
];

// "/post/welcome-post" should mark "Blog" as the current page.
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (path: string) =>
  path === '/' ? pathname === '/' : pathname === path || pathname.startsWith(`${path}/`);
---

<nav class="bg-background text-foreground">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between p-4">
    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <span class="self-center whitespace-nowrap text-4xl font-semibold">dundu does stuff</span>
    </a>

    <!-- Button to open the menu on mobile. -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-sm md:hidden"
      aria-controls="navbar-mobile"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg data-icon="open" class="text-2xl text-foreground" fill="currentColor" viewBox="0 0 512 512" width="1em" height="1em" aria-hidden="true">
        <path d="M64 384h384v-42.666H64V384zm0-106.666h384v-42.667H64v42.667zM64 128v42.665h384V128H64z"></path>
      </svg>
      <svg data-icon="close" class="hidden text-2xl text-foreground" fill="currentColor" viewBox="0 0 512 512" width="1em" height="1em" aria-hidden="true">
        <path d="M405 136.798L375.202 107 256 226.202 136.798 107 107 136.798 226.202 256 107 375.202 136.798 405 256 285.798 375.202 405 405 375.202 285.798 256z"></path>
      </svg>
    </button>

    <!-- On desktop, we just use a navbar. -->
    <div class="hidden w-full md:block md:w-auto">
      <ul class="mt-4 flex flex-col rounded-lg border p-4 font-medium md:mt-0 md:flex-row md:space-x-8 md:border-0 md:p-0 rtl:space-x-reverse">
        {
          menuItems.map((item) => (
            <li class="p-2 hover:rounded-md hover:shadow-inner">
              <a
                href={item.path}
                class="block rounded-sm px-3 py-2 text-2xl md:p-0"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.name.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- On mobile, we use a collapsible menu. -->
    <div id="navbar-mobile" class="hidden w-full md:hidden">
      <ul class="mt-4 flex flex-col rounded-lg p-4 font-medium shadow-inner">
        {
          menuItems.map((item) => (
            <li>
              <a
                href={item.path}
                class="block rounded-sm px-3 py-2 text-2xl hover:font-semibold"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.name.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('navbar-mobile')!;

  toggle.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('[data-icon="open"]')!.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')!.classList.toggle('hidden', !open);
  });
</script>
