---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingMinutes } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, summary, cover, coverAlt, tags } = post.data;
---

<!--
  The title link stretches over the whole item (after:absolute), so the row is one big click target.
  data-tags is read by the tag filter on the blog page.
-->
<article data-tags={JSON.stringify(tags)} class="group relative flex items-start gap-5 py-7 sm:gap-8 sm:py-9">
  <div class="min-w-0 flex-1">
    <h2 class="text-2xl leading-snug text-balance sm:text-3xl">
      <a href={`/post/${post.id}`} class="after:absolute after:inset-0 group-hover:text-(--link-color)">
        {title}
      </a>
    </h2>
    <p class="mt-2 flex flex-wrap gap-x-2 text-base whitespace-nowrap text-muted">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post.body)} min read</span>
    </p>
    {summary && <p class="mt-2.5 text-lg leading-relaxed text-pretty text-(--text-soft) sm:text-xl">{summary}</p>}
  </div>
  {
    cover && (
      <Picture
        src={cover}
        alt={coverAlt ?? ''}
        formats={['avif', 'webp']}
        width={272}
        height={272}
        widths={[96, 136, 192, 272]}
        sizes="(min-width: 640px) 8.5rem, 6rem"
        fit="cover"
        class="aspect-square w-24 shrink-0 rounded-xl object-cover sm:w-34"
      />
    )
  }
</article>
