---
import PostListItem from '../../components/PostListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog">
  <!-- Same 44rem column as the posts themselves. -->
  <main class="mx-auto max-w-[44rem] px-5 pt-4 pb-20 sm:px-6 sm:pt-8">
    <h1 class="sr-only">Blog posts</h1>
    <div class="divide-y divide-accent/40">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>
  </main>
</BaseLayout>
