---
import PostListItem from '../../components/PostListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { pressedUnderline } from '../../lib/underline';

const posts = await getPublishedPosts();

// Every tag on a published post, most used first, then alphabetical.
const counts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.keys()].sort((a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b));

// Filters are plain words with the site's growing underline (the same one as the nav):
// muted until hovered or selected, when they ease to full colour.
const filterButton = `cursor-pointer text-muted transition-colors duration-400 ease-out hover:text-foreground aria-pressed:text-foreground motion-reduce:transition-none ${pressedUnderline}`;
---

<BaseLayout title="Blog">
  <!-- Same 44rem column as the posts themselves. -->
  <main class="mx-auto max-w-[44rem] px-5 pb-12 sm:px-6">
    <!-- Laid out like a post's header: a centred title. -->
    <header class="mt-10 text-center sm:mt-16">
      <h1 class="text-4xl leading-tight sm:text-5xl">Writing</h1>
    </header>

    <!--
      Tag filter. Picking tags shows posts with any of them; "All posts" clears the
      selection. Without JavaScript the filters stay hidden and every post is listed.
    -->
    {
      tags.length > 0 && (
        <div
          id="tag-filter"
          class="mt-6 flex flex-wrap justify-center gap-x-7 gap-y-3 text-lg sm:mt-8"
          role="group"
          aria-label="Filter posts by tag"
          hidden
        >
          <button type="button" class={filterButton} data-tag="" aria-pressed="true">
            all posts
          </button>
          {tags.map((tag) => (
            <button type="button" class={filterButton} data-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      )
    }
    <p id="filter-status" class="sr-only" aria-live="polite"></p>

    <!-- Rules go between visible posts only, so filtering never leaves a stray line. -->
    <div
      id="post-list"
      class="mt-6 sm:mt-10 [&>article]:border-accent/40 [&>article:not([hidden])~article:not([hidden])]:border-t"
    >
      {posts.map((post) => <PostListItem post={post} />)}
    </div>
  </main>
</BaseLayout>

<script>
  const filter = document.getElementById('tag-filter');
  const status = document.getElementById('filter-status')!;
  const posts = [...document.querySelectorAll<HTMLElement>('#post-list > article')];

  if (filter) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button')];
    const known = new Set(buttons.map((button) => button.dataset.tag).filter(Boolean));
    // Selected tags live in the URL (?tag=A&tag=B) so a filtered view can be shared.
    const selected = new Set(new URL(location.href).searchParams.getAll('tag').filter((tag) => known.has(tag)));

    const apply = () => {
      for (const button of buttons) {
        const tag = button.dataset.tag!;
        button.setAttribute('aria-pressed', String(tag ? selected.has(tag) : selected.size === 0));
      }
      let shown = 0;
      for (const post of posts) {
        const tags: string[] = JSON.parse(post.dataset.tags ?? '[]');
        post.hidden = selected.size > 0 && !tags.some((tag) => selected.has(tag));
        if (!post.hidden) shown++;
      }
      status.textContent = `Showing ${shown} ${shown === 1 ? 'post' : 'posts'}`;

      const url = new URL(location.href);
      url.searchParams.delete('tag');
      for (const tag of selected) url.searchParams.append('tag', tag);
      history.replaceState(null, '', url);
    };

    filter.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button');
      if (!button) return;
      const tag = button.dataset.tag;
      if (!tag) selected.clear();
      else if (!selected.delete(tag)) selected.add(tag);
      apply();
    });

    filter.hidden = false;
    if (selected.size > 0) apply();
  }
</script>
