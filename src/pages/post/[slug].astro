---
import { render } from 'astro:content';
import TitleRule from '../../components/TitleRule.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary || undefined}>
  <!-- 44rem keeps 20px body lines around 65-70 characters, a comfortable reading length. -->
  <article class="mx-auto max-w-[44rem] px-5 pb-20 text-foreground sm:px-6">
    <header class="mt-10 mb-10 text-center sm:mt-16 sm:mb-14">
      <h1 class="text-4xl leading-tight text-balance sm:text-5xl">{post.data.title}</h1>
      <div class="mt-5 flex items-center justify-center gap-3 text-base text-muted">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        {
          post.data.tags.length > 0 && (
            <>
              <span>{post.data.tags.join(', ')}</span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <!-- Plain text like the date and tags beside it; it reads "link copied" for a moment after a click. -->
        <button
          id="copy-link"
          type="button"
          class="cursor-pointer transition-colors duration-400 ease-out hover:text-(--link-color) motion-reduce:transition-none"
        >
          copy link
        </button>
        <span id="copy-status" class="sr-only" aria-live="polite"></span>
      </div>
      <TitleRule class="mt-8 sm:mt-10" />
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const button = document.getElementById('copy-link')!;
  const status = document.getElementById('copy-status')!;
  let timer: ReturnType<typeof setTimeout>;

  button.addEventListener('click', async () => {
    let message: string;
    try {
      await navigator.clipboard.writeText(window.location.href);
      message = 'link copied';
    } catch {
      message = "couldn't copy";
    }
    button.textContent = status.textContent = message;
    clearTimeout(timer);
    timer = setTimeout(() => {
      button.textContent = 'copy link';
      status.textContent = '';
    }, 2000);
  });
</script>
