---
import { render } from 'astro:content';
import LinkIcon from '../../components/LinkIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary || undefined}>
  <!-- 44rem keeps 20px body lines around 65-70 characters, a comfortable reading length. -->
  <article class="mx-auto max-w-[44rem] px-5 pb-20 text-foreground sm:px-6">
    <header class="mt-10 mb-10 text-center sm:mt-16 sm:mb-14">
      <h1 class="text-4xl leading-tight font-medium text-balance sm:text-5xl">{post.data.title}</h1>
      <div class="mt-5 flex items-center justify-center gap-3 text-base text-muted">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        {
          post.data.tags.length > 0 && (
            <>
              <span>{post.data.tags.join(', ')}</span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <span class="relative inline-flex">
          <button
            id="copy-link"
            type="button"
            class="h-8 w-8 cursor-pointer rounded-full border border-current/30 p-1.5 transition-colors hover:border-current hover:text-foreground"
            aria-label="Copy link to this post"
            title="Copy link to this post"
          >
            <LinkIcon class="h-full w-full" />
          </button>
          <span
            id="copy-status"
            class="absolute top-full right-0 mt-1 text-sm whitespace-nowrap"
            aria-live="polite"></span>
        </span>
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const button = document.getElementById('copy-link')!;
  const status = document.getElementById('copy-status')!;
  let timer: ReturnType<typeof setTimeout>;

  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      status.textContent = 'link copied!';
    } catch {
      status.textContent = "couldn't copy the link";
    }
    clearTimeout(timer);
    timer = setTimeout(() => (status.textContent = ''), 2000);
  });
</script>
