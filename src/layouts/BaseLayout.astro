---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Dundu Does Stuff';
const { title, description = 'My corner of the internet.' } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
// Pages build to post.html etc. (see astro.config.mjs) but are served without the extension.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const ogImage = new URL('/opengraph-image.jpeg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7eede" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1a0a" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="64x64" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="854" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-background antialiased">
    <Navbar />
    <slot />
    <Footer name="dundu does stuff" since={2024} />
  </body>
</html>
